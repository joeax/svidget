{
  "name": "svidget",
  "version": "0.4.0",
  "description": "Framework for widgetizing SVG on the web.",
  "author": "Joe Agster",
  "keywords": [
    "svg",
    "widget",
    "visualization",
    "html5",
    "javascript"
  ],
  "main": "dist/svidget.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/joeax/svidget.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/joeax/svidget/issues"
  },
  "homepage": "https://www.svidget.io",
  "devDependencies": {
    "@swc/core": "^1.13.2",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist",
    "buildsvg": "tsup src/index.svg.ts --config tsup.config.svg.ts"
  }
}
